// Terminals (mots-clés et ponctuation)
MODEL: "MODEL"
SETS: "SETS"
ENDSETS: "ENDSETS"
DATA: "DATA"
ENDDATA: "ENDDATA"
END: "END"
MAX: "MAX"
MIN: "MIN"
FOR: "@FOR"
SUM: "@SUM"

COLON: ":"
SEMICOLON: ";"
COMMA: ","
LPAR: "("
RPAR: ")"
LBRACK: "["
RBRACK: "]"

LE: "<="
GE: ">="
EQ: "="

PLUS: "+"
MINUS: "-"
TIMES: "*"
DIVIDE: "/"

BIN: "@BIN"

// Importations
%import common.CNAME -> NAME
%import common.SIGNED_NUMBER -> NUMBER
%import common.WS_INLINE
%import common.NEWLINE

// Ignorés
%ignore WS_INLINE
%ignore NEWLINE
%ignore /!.*(\r?\n)?/

// Grammaire principale

start: model_decl statement* end_decl

model_decl: MODEL COLON

end_decl: END

statement: set_block
         | data_block
         | objective
         | constraint
         | label

label: LBRACK LABEL_TEXT RBRACK

LABEL_TEXT: /[^\]\n\r]+/

set_block: SETS COLON set_decl+ ENDSETS

set_decl: NAME LPAR simple_name_list RPAR COLON name_list SEMICOLON
        | NAME "/" name_list "/" COLON name_list SEMICOLON
        | NAME "/" name_list "/" COLON NAME SEMICOLON
        | NAME "/" name_list "/" COLON SEMICOLON
        | NAME "/" name_list "/" SEMICOLON
        | NAME COLON name_list SEMICOLON

name_list: name_elem (COMMA name_elem)*

name_elem: (NAME | NUMBER) (".." (NAME | NUMBER))?  -> name_range

simple_name_list: (NAME | NUMBER) (COMMA (NAME | NUMBER))*

data_block: DATA COLON data_stmt+ ENDDATA

// Support pour NAME = ..., ou NAME, NAME, ... = ...
data_stmt: NAME (COMMA NAME)* "=" (ole_source | number_list_or_matrix) SEMICOLON?

// Source de données pour @OLE ou @ODBC
ole_source: "@OLE" LPAR STRING_LITERAL RPAR        -> ole_import
          | "@ODBC" LPAR STRING_LITERAL (SEMICOLON NAME)* RPAR -> odbc_import

// Littéral de chaîne entre guillemets
STRING_LITERAL: /"[^"]*"/ | /'[^']*'/

objective: (MAX | MIN) EQ expr SEMICOLON

constraint: for_loop
          | expr comp_op expr SEMICOLON

for_loop: FOR LPAR indexset COLON for_loop_body RPAR SEMICOLON
for_loop_body: expr_with_comp | expr | for_loop_inner
for_loop_inner: FOR LPAR indexset COLON for_loop_body RPAR

expr_with_comp: expr comp_op expr

expr: sum_expr

bin_expr: BIN LPAR expr RPAR


sum_expr: term ((PLUS | MINUS) term)*

term: factor ((TIMES | DIVIDE) factor)*

factor: NUMBER
      | NAME
      | NAME LPAR index_value RPAR         -> param_ref
      | NAME LPAR index_value COMMA index_value RPAR -> param_ref2
      | SUM LPAR indexset COLON expr RPAR -> sum_expr
      | BIN LPAR expr RPAR           -> bin_expr
      | LPAR expr RPAR

indexset: NAME
        | NAME LPAR NAME RPAR      -> indexed_set
        | NAME LPAR NAME COMMA NAME RPAR -> indexed_set2

index_value: NAME | NUMBER

comp_op: LE | GE | EQ

number_list_or_matrix: number_list (COMMA NEWLINE? number_list)*

number_list: NUMBER (COMMA NUMBER)*
