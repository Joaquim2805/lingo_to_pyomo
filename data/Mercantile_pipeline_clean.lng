MODEL: 
SETS:
MOIS:ESPACE;
PERIODES:COUT;
ARC(MOIS,PERIODES):X;
ENDSETS

DATA:
ESPACE = 30000,20000,40000,10000,50000;
COUT = 65,100,135,160,190;
ENDDATA

!fonction objectif;
MIN=@SUM(ARC:COUT*X);

!contraintes;
@FOR(MOIS(m): @SUM(MOIS(k) | k#LE#m:@SUM(PERIODES(j) | k+j #GT#m:X(k,j)))>=ESPACE(m));

END