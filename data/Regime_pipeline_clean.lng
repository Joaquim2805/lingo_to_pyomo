MODEL:

SETS:
ALIMENTS /Brownie,Cremeglacee,Cola,Gateau/:Prix,Calories,X;
INGREDIENTS /Calories,Chocolat,Sucre,Matieregrasse/:DIETEJOUR;
ARCS(ALIMENTS,INGREDIENTS):QTEING;
ENDSETS

DATA:
Prix = 50,20,30,80;
Calories = 400,200,150,500;
DIETEJOUR = 500,6,10,8;
QTEING = 400,3,2,2,200,2,2,4,150,0,4,1,500,0,4,5;
ENDDATA
!Fonction objectif;
 MIN = @SUM(ALIMENTS(a):Prix(a) * X(a));
!Contrainte;
@FOR(INGREDIENTS(i): @SUM(ALIMENTS(a):QTEING(a,i) * X(a))>=DIETEJOUR(i)
);

@SUM(ALIMENTS: Calories(a) * X(a))>=500;

END
