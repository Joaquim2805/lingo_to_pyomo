MODEL :
SETS:
PRODUITS /P1,P2/:Gain, X;
USINES /U1,U2,U3/:DISP;
PRODS_USINES(USINES,PRODUITS): UTILISATION;
ENDSETS

DATA:
Gain = 3,5;
DISP = 4,12,18;
UTILISATION = 1,0,0,2,3,2;
ENDDATA

MAX = @SUM (PRODUITS(p):
 Gain(p)*X(p)
);

@FOR(USINES(u): 
 @SUM(PRODUITS(p):
 UTILISATION(u,p)*X(p))<=DISP(u)
);

END