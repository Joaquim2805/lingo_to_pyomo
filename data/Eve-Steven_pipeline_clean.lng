MODEL:

SETS:
TACHES/marche,cuisine,vaisselle,buanderie/:;
PERSONNES/Eve,Steven/:;
ARC(PERSONNES,TACHES):Temps,X;
ENDSETS

DATA:
Temps=4.5,7.8,3.6,2.9,
 4.9,7.2,4.3,3.1;
ENDDATA

!FO+Temps total passe aux taches;
!MIN=@SUM(ARC:Temps*X);

MIN=@SUM(PERSONNES(p):@SUM(TACHES(t):Temps(p,t)*X(p,t)));

!SAC;
!deux taches chacun;
@FOR(PERSONNES(p):@SUM(TACHES(t):X(p,t))=2);

!Toutes les taches sont faites une seule fois;
@FOR(TACHES(t):@SUM(PERSONNES(p):X(p,t))=1);

!variables binaires;
@FOR(ARC:@BIN(X));
END