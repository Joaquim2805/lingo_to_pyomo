!ENONCE:

MODEL:

SETS:
CLIENTS/1,2,3/;
PRODUCTION/0,1,2,3,4,5/;
ARC(PRODUCTION,CLIENTS):capacite,revenu,x;
ENDSETS

DATA:
bigM=1000000;!grand chiffre;
revenu=0,0,0,
	1,1,1,
	2,5,3,
	4,0,5,
	0,0,6,
	0,0,7;
capacite=0,0,0,
	0.2,0.4,0.2,
	0.4,0.8,0.4,
	0.6,1.2,0.6,
	0.8,1.2,0.8,
	1,1.2,1;!on met une occupation de 120% des que la capacite est depassee (commande impossible);
ENDDATA

!Fonction objectif (Profit-Revenu);
MAX=@SUM(ARC:revenu*x);

!SAC;

!Capacite de production a ne pas depasser;
@SUM(ARC:capacite*x)<=1;

!on ne peut produire qu une quantite par client;
@FOR(CLIENTS(c):@SUM(PRODUCTION(p):x(p,c))<=1);

!Variables binaires;
@FOR(ARC:@BIN(x));


END