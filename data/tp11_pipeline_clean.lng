MODEL :
SETS:
employes/1,2,3,4,5/:;
taches/1,2,3,4,5/:;
ARC(employes,taches):C,X;
ENDSETS

DATA:
C=39,65,69,66,57,
64,84,24,92,22,
49,50,61,31,45,
48,45,55,23,50,
59,34,30,34,18;
ENDDATA

MIN = @SUM(ARC(e,t):C(e,t)*X(e,t));
@FOR(taches(t):@SUM(employes(e):X(e,t))=1);
!@for(employes(e):@sum(taches(t):X(e,t))=1);
!@FOR(ARC(e,t):X(e,t)<=1);

@FOR(employes(e):@FOR(taches(t):X(e,t) <= 1));

X(5,5)<=0;X(5,2)>=1;
!X(5,2)<=0;!X(5,5)>=1;

!X(4,4)<=0;!X(4,2)>=1;
!X(4,2)<=0;!X(4,4)>=1;

!X(2,5)<=0;!X(2,3)>=1;
X(2,3)<=0;X(2,5)>=1;

X(5,3)<=0;X(5,2)>=1;
!X(5,2)<=0;!X(5,3)>=1;
END