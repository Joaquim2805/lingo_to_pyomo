MODEL:

SETS:
ALIMENTS /Brownie,Cremeglacée,Cola,Gateau/:Prix,Calories,X;
INGREDIENTS /Calories,Chocolat,Sucre,Matieregrasse/:Dietejour;
ARCS(ALIMENTS,INGREDIENTS):Qteing;
ENDSETS

DATA:
Prix = 50,20,30,80;
Calories = 400,200,150,500;
DIetejour = 500,6,10,8;
Qteing = 400,3,2,2,200,2,2,4,150,0,4,1,500,0,4,5;
ENDDATA
!Fonction objectif;
[regimeeco] MIN = @SUM(ALIMENTS:Prix * X);
!Contrainte;
@FOR(INGREDIENTS(i):[mangerdetout] @SUM(ALIMENTS(a):Qteing(a,i) * X(a))>=Dietejour(i)
);

@SUM(ALIMENTS: Calories * X)>=500;

DATA:

ENDDATA

END
